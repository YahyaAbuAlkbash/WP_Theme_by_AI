{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#2563eb"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#7c3aed"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#f59e0b"
				},
				{
					"name": "Dark",
					"slug": "dark",
					"color": "#1e293b"
				},
				{
					"name": "Light",
					"slug": "light",
					"color": "#f8fafc"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "#0f172a"
				},
				{
					"name": "Text Light",
					"slug": "text-light",
					"color": "#64748b"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"name": "Primary to Secondary",
					"slug": "primary-secondary",
					"gradient": "linear-gradient(135deg, #2563eb 0%, #7c3aed 100%)"
				},
				{
					"name": "Primary to Accent",
					"slug": "primary-accent",
					"gradient": "linear-gradient(135deg, #2563eb 0%, #f59e0b 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "14px"
				},
				{
					"name": "Normal",
					"slug": "normal",
					"size": "18px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "24px"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "32px"
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "40px"
				}
			],
			"fontFamilies": [
				{
					"name": "System Sans-Serif",
					"slug": "system-sans-serif",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
				},
				{
					"name": "Headings",
					"slug": "headings",
					"fontFamily": "\"Poppins\", -apple-system, BlinkMacSystemFont, sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "monospace",
					"fontFamily": "\"JetBrains Mono\", \"Courier New\", monospace"
				}
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#0f172a"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans-serif)",
			"fontSize": "18px",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headings)",
					"fontSize": "2.5rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "#1e293b"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headings)",
					"fontSize": "2rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "#1e293b"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headings)",
					"fontSize": "1.75rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "#1e293b"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headings)",
					"fontSize": "1.5rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "#1e293b"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headings)",
					"fontSize": "1.25rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "#1e293b"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headings)",
					"fontSize": "1rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "#1e293b"
				}
			},
			"link": {
				"color": {
					"text": "#2563eb"
				},
				":hover": {
					"color": {
						"text": "#1e40af"
					}
				}
			},
			"button": {
				"color": {
					"background": "#2563eb",
					"text": "#ffffff"
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "#1e40af"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "4px"
				}
			},
			"core/quote": {
				"border": {
					"width": "0 0 0 4px",
					"style": "solid",
					"color": "#2563eb"
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				},
				"color": {
					"background": "#f8fafc"
				}
			},
			"core/code": {
				"color": {
					"background": "#f1f5f9"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)"
				}
			}
		}
	}
}
